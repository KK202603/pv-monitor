# Shelly Geräte Konfiguration
# Gerät 1 (z.B. PV Waschhütte)
SHELLY_1_IP=192.168.x.x
SHELLY_1_NAME=PV Waschhütte
SHELLY_1_MODEL=gen2

# Gerät 2 (z.B. PV Öfner)
SHELLY_2_IP=192.168.x.x
SHELLY_2_NAME=PV Öfner
SHELLY_2_MODEL=gen2

# Strompreis in Cent pro kWh
STROMPREIS_CENT=28

# Anschaffungskosten der Anlagen in EUR
ANLAGE_1_KOSTEN=399.00
ANLAGE_2_KOSTEN=349.00

# Inbetriebnahmedaten (YYYY-MM-DD)
INBETRIEBNAHME_1=2024-03-15
INBETRIEBNAHME_2=2024-06-01

# Datenbankpfad (im Container)
DB_PATH=/app/data/pv.db

# Abfrageintervall in Sekunden
POLL_INTERVAL=60
